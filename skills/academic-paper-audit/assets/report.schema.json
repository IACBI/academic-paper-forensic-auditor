{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Paper Audit Report v.0.0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit", "disclaimer", "artifacts", "coverage", "sources", "findings", "assessment", "evidence_against_concerns", "limitations", "next_steps"],
  "properties": {
    "schema_version": {"const": "0.0.2"},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "created_at", "package_version", "analyst", "scope", "article", "tools"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "created_at": {"type": "string", "format": "date-time"},
        "package_version": {"const": "0.0.2"},
        "analyst": {"type": ["string", "null"], "minLength": 1},
        "scope": {"$ref": "#/$defs/text"},
        "research_context": {
          "type": "object", "additionalProperties": false,
          "required": ["disciplines", "method_families", "applicability_notes"],
          "properties": {
            "disciplines": {"$ref": "#/$defs/strings"},
            "method_families": {"$ref": "#/$defs/strings"},
            "applicability_notes": {"$ref": "#/$defs/text"}
          }
        },
        "article": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "doi", "version"],
          "properties": {
            "title": {"$ref": "#/$defs/text"},
            "doi": {"type": ["string", "null"], "minLength": 1},
            "version": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "tools": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version", "action", "parameters", "outcome"],
            "properties": {
              "name": {"$ref": "#/$defs/text"},
              "version": {"type": ["string", "null"], "minLength": 1},
              "action": {"$ref": "#/$defs/text"},
              "parameters": {"type": "object"},
              "outcome": {"enum": ["completed", "failed", "unavailable"]}
            }
          }
        }
      }
    },
    "disclaimer": {"$ref": "#/$defs/text"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "coverage": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/coverage"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["insufficient_evidence", "no_significant_anomaly", "minor_anomalies", "clarification_required", "expert_review_required", "externally_documented_issue"]},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "evidence_against_concerns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "limitations": {"$ref": "#/$defs/strings"},
    "next_steps": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind", "size_bytes", "sha256", "derived_from", "transformations", "limitation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["original", "derived"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "derived_from": {"$ref": "#/$defs/ids"},
        "transformations": {"$ref": "#/$defs/strings"},
        "limitation": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "status", "scope", "checks", "artifact_ids", "source_ids", "limitations"],
      "properties": {
        "domain": {"enum": ["text_methods", "statistics_data", "figures_images", "metadata_provenance", "references_notices", "ethics_registration", "cross_paper"]},
        "status": {"enum": ["completed", "partial", "not_assessed", "not_applicable"]},
        "scope": {"$ref": "#/$defs/text"},
        "checks": {"$ref": "#/$defs/strings"},
        "artifact_ids": {"$ref": "#/$defs/ids"},
        "source_ids": {"$ref": "#/$defs/ids"},
        "limitations": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["completed", "partial"]}}}, "then": {"properties": {"checks": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["not_assessed", "not_applicable"]}}}, "then": {"properties": {"checks": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"enum": ["partial", "not_assessed", "not_applicable"]}}}, "then": {"properties": {"limitations": {"minLength": 1, "pattern": "\\S"}}}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "title", "issuer", "accessed_at", "authoritative", "article_match", "access_status", "statement", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
        "identifier": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "title": {"$ref": "#/$defs/text"},
        "issuer": {"$ref": "#/$defs/text"},
        "accessed_at": {"type": "string", "format": "date-time"},
        "authoritative": {"type": "boolean"},
        "article_match": {"type": "boolean"},
        "access_status": {"enum": ["read", "metadata_only", "unavailable"]},
        "statement": {"$ref": "#/$defs/text"},
        "limitations": {"type": "string"}
      },
      "if": {"properties": {"url": {"type": "null"}}},
      "then": {"required": ["identifier"], "properties": {"identifier": {"$ref": "#/$defs/text"}}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "status", "level", "confidence", "artifact_ids", "source_ids", "locator", "observation", "evidence", "reproduction", "assumptions", "benign_explanation", "self_challenge", "impact", "verification_needed", "human_review_required", "related_findings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "category": {"enum": ["text_methods", "statistics_data", "figures_images", "metadata_provenance", "references_notices", "ethics_registration", "cross_paper"]},
        "issue_kind": {"enum": ["reporting_gap", "methodological_limitation", "reproducible_inconsistency", "integrity_concern", "externally_documented_issue"]},
        "status": {"enum": ["active", "resolved", "withdrawn"]},
        "level": {"type": "integer", "minimum": 1, "maximum": 4},
        "confidence": {"enum": ["low", "medium", "high"]},
        "artifact_ids": {"$ref": "#/$defs/ids"},
        "source_ids": {"$ref": "#/$defs/ids"},
        "locator": {"$ref": "#/$defs/text"},
        "observation": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"},
        "reproduction": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "assumptions": {"$ref": "#/$defs/strings"},
        "benign_explanation": {"$ref": "#/$defs/text"},
        "self_challenge": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome", "details"],
          "properties": {
            "outcome": {"enum": ["survived", "downgraded", "resolved", "not_performed"]},
            "details": {"$ref": "#/$defs/text"}
          }
        },
        "impact": {"$ref": "#/$defs/text"},
        "verification_needed": {"$ref": "#/$defs/text"},
        "human_review_required": {"type": "boolean"},
        "related_findings": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
